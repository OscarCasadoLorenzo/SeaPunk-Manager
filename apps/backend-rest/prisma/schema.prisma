// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MASTER
  PLAYER
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  password  String      // hashed password
  name      String
  role      UserRole    @default(PLAYER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  characters Character[]

  @@map("users")
}

model Character {
  id                        String        @id @default(cuid())
  characterName             String
  archetype                 String
  faction                   String
  race                      String
  level                     Int
  epicPoints                Int
  type                      String
  isNPC                     Boolean       @default(false)
  isVisible                 Boolean       @default(true)
  userId                    String
  // Legacy fields from old schema (restored for backward compatibility)
  bcat                      Int           @default(0)
  powerLevel                Int           @default(0)
  physicalResistanceDomain  String?
  mentalResistanceDomain    String?
  defenseDomain             String?
  attackDomain              String?
  impactDomain              String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  user                      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attributes                Attribute?
  domains                   Domain?
  combatStats               CombatStats?
  narrative                 Narrative?
  inventories               Inventory[]
  effects                   Effect[]
  essences                  CharacterEssence[]
  auraGifts                 CharacterAuraGift[]

  @@map("characters")
}

model Attribute {
  id           String    @id @default(cuid())
  characterId  String    @unique
  strength     Int
  agility      Int
  willpower    Int
  luck         Int
  intelligence Int
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("attributes")
}

model Domain {
  id            String    @id @default(cuid())
  characterId   String    @unique
  physical      Int
  combat        Int
  social        Int
  environmental Int
  stealth       Int
  knowledge     Int
  technical     Int
  resources     Int
  demonic       Int
  aura          Int
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("domains")
}

model CombatStats {
  id                    String    @id @default(cuid())
  characterId           String    @unique
  physicalHealth        Int
  maxPhysicalHealth     Int
  physicalResistance    Int
  maxPhysicalResistance Int
  mentalHealth          Int
  maxMentalHealth       Int
  mentalResistance      Int
  maxMentalResistance   Int
  auraHealth           Int       @default(0)
  maxAuraHealth        Int       @default(0)
  auraResistance       Int       @default(0)
  maxAuraResistance    Int       @default(0)
  initiative            Int
  armorClass           Int       @default(10)
  conditions           String[]  @default([])
  defense              Int       @default(10)
  attack               Int       @default(0)
  impact               Int       @default(0)
  maxDamage            Int       @default(0)
  character             Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("combat_stats")
}

model Narrative {
  id                  String    @id @default(cuid())
  characterId         String    @unique
  physicalDescription String?
  externalProfile     String?
  internalProfile     String?
  background          String?
  specialties         String?
  character           Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("narratives")
}

enum InventoryType {
  WEAPON
  ARMOR
  CONSUMABLE
  QUEST
  OTHER
}

model Inventory {
  id          String    @id @default(cuid())
  characterId String
  name        String
  description String?
  quantity    Int       @default(1)
  type        String    // Changed from InventoryType enum to String for flexibility
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("inventories")
}

model Effect {
  id          String    @id @default(cuid())
  characterId String
  name        String
  duration    Int
  type        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("effects")
}

model Essence {
  id         String             @id @default(cuid())
  name       String             @unique
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  characters CharacterEssence[]

  @@map("essences")
}

model AuraGift {
  id         String              @id @default(cuid())
  name       String              @unique
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  characters CharacterAuraGift[]

  @@map("aura_gifts")
}

// Many-to-many relationship tables
model CharacterEssence {
  id          String    @id @default(cuid())
  characterId String
  essenceId   String
  level       Int       @default(1)
  createdAt   DateTime  @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  essence     Essence   @relation(fields: [essenceId], references: [id], onDelete: Cascade)

  @@unique([characterId, essenceId])
  @@map("character_essences")
}

model CharacterAuraGift {
  id          String    @id @default(cuid())
  characterId String
  auraGiftId  String
  level       Int      @default(1)
  createdAt   DateTime @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  auraGift    AuraGift @relation(fields: [auraGiftId], references: [id], onDelete: Cascade)

  @@unique([characterId, auraGiftId])
  @@map("character_aura_gifts")
}
