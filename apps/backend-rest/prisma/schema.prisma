// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MASTER
  PLAYER
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  password  String      // hashed password
  name      String
  role      UserRole    @default(PLAYER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  characters Character[]

  @@map("users")
}

model Character {
  id                        String        @id @default(cuid())
  characterName             String        @unique
  archetype                 String
  faction                   String
  race                      String
  level                     Int
  epicPoints                Int
  type                      String
  isNPC                     Boolean       @default(false)
  isVisible                 Boolean       @default(true)
  userId                    String
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  user                      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attributes                Attribute?
  domains                   Domain?
  combatStats               CombatStats?
  narrative                 Narrative?
  inventories               Inventory[]
  effects                   Effect[]
  auraGifts                 CharacterAuraGift[]

  @@map("characters")
}

model Attribute {
  id           String    @id @default(cuid())
  characterId  String    @unique
  strength     Int
  agility      Int
  willpower    Int
  luck         Int
  intelligence Int
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("attributes")
}

model Domain {
  id                  String    @id @default(cuid())
  characterId         String    @unique
  physicalValue       Int
  physicalEssence     String    @default("")
  combatValue         Int
  combatEssence       String    @default("")
  socialValue         Int
  socialEssence       String    @default("")
  environmentalValue  Int
  environmentalEssence String   @default("")
  stealthValue        Int
  stealthEssence      String    @default("")
  knowledgeValue      Int
  knowledgeEssence    String    @default("")
  technicalValue      Int
  technicalEssence    String    @default("")
  resourcesValue      Int
  resourcesEssence    String    @default("")
  demonicValue        Int
  demonicEssence      String    @default("")
  auraValue           Int
  auraEssence         String    @default("")
  character           Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("domains")
}

model CombatStats {
  id                    String    @id @default(cuid())
  characterId           String    @unique

  physicalHealth        Int
  maxPhysicalHealth     Int

  physicalResistance    Int
  maxPhysicalResistance Int

  mentalHealth          Int
  maxMentalHealth       Int

  mentalResistance      Int
  maxMentalResistance   Int

  initiative            Int       @default(0)
  maxInitiative         Int       @default(0)

  defense               Int       @default(0)
  maxDefense            Int       @default(0)

  attack                Int       @default(0)
  maxAttack             Int       @default(0)

  impact                Int       @default(0)
  maxImpact             Int       @default(0)

  maxDamage             Int       @default(0)

  character             Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("combat_stats")
}

model Narrative {
  id                  String    @id @default(cuid())
  characterId         String    @unique
  physicalDescription String?
  externalProfile     String?
  internalProfile     String?
  background          String?
  specialties         String?
  character           Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("narratives")
}

enum InventoryType {
  WEAPON
  ARMOR
  CONSUMABLE
  QUEST
  OTHER
}

model Inventory {
  id          String    @id @default(cuid())
  characterId String
  name        String
  description String?
  quantity    Int       @default(1)
  type        String    // Changed from InventoryType enum to String for flexibility
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("inventories")
}

model Effect {
  id          String    @id @default(cuid())
  characterId String
  name        String
  duration    Int
  type        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("effects")
}

model AuraGift {
  id         String              @id @default(cuid())
  name       String              @unique
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  characters CharacterAuraGift[]

  @@map("aura_gifts")
}

// Many-to-many relationship tables
model CharacterAuraGift {
  id          String    @id @default(cuid())
  characterId String
  auraGiftId  String
  level       Int      @default(1)
  createdAt   DateTime @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  auraGift    AuraGift @relation(fields: [auraGiftId], references: [id], onDelete: Cascade)

  @@unique([characterId, auraGiftId])
  @@map("character_aura_gifts")
}
