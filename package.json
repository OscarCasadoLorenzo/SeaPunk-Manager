{
  "name": "seapunk-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack desktop application built with Electron, React, Node.js, and PostgreSQL",
  "main": "dist/electron/main.js",
  "author": "Your Name",
  "license": "MIT",
  "homepage": "./",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:renderer": "cd renderer && npm run dev",
    "dev:electron": "wait-on tcp:3001 && wait-on tcp:3000 && electron .",
    "build": "npm run build:backend && npm run build:renderer && npm run build:electron",
    "build:backend": "cd backend && npm run build",
    "build:renderer": "cd renderer && npm run build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "postinstall": "cd backend && npm install && cd ../renderer && npm install",
    "clean": "rimraf dist build",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "concurrently": "^8.2.2",
    "electron": "^27.1.3",
    "electron-builder": "^24.6.4",
    "electron-is-dev": "^2.0.0",
    "eslint": "^8.55.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.seapunk.manager",
    "productName": "SeaPunk Manager",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "backend/dist/**/*",
      "renderer/dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "lucide-react": "^0.525.0"
  }
}
